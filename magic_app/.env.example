# Railway / локальный запуск (скопируйте в .env.local)

# Upstash Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Auth
JWT_SECRET=

# AI
DEEPSEEK_API_KEY=

# Yandex SpeechKit (TTS + STT)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# Admin panel
# ВАЖНО: без этих трёх переменных сервер (server.js) больше не запускается
# в production — раньше при их отсутствии код тихо подставлял захардкоженные
# значения ('admin@geroy-skazki.local' / 'admintuti13' / 'admin-token-v5.0.5'),
# что было дырой безопасности. См. SECURITY_FIXES.md.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_API_TOKEN=
ADMIN_EMAILS=admin@geroy-skazki.local

# Реальная верификация промокодов PSY-/SPEC-/ORPH- (опционально).
# SHA-256 хеш общего "мастер"-кода для соответствующего типа — если задан,
# код, введённый при регистрации, сверяется по хешу timing-safe сравнением.
# Без этого промокод всё равно принимается, если он реально выдан админом
# через одобрение заявки (admin-applications.js) — см. _lib/promo-verify.js.
# Посчитать хеш: node -e "console.log(require('crypto').createHash('sha256').update('ВАШ_КОД').digest('hex'))"
PSY_PROMO_HASH=
SPEC_PROMO_HASH=
ORPH_PROMO_HASH=

# Email (weekly-digest)
RESEND_API_KEY=

# Server
PORT=3000
NODE_ENV=production

# Railway (автоматически задаётся платформой)
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
