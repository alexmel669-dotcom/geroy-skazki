# Первый запуск создаёт /etc/geroy-skazki/.env и генерирует отдельные секреты.
ADMIN_EMAIL=
ADMIN_PASSWORD=GENERATE_ON_INSTALL
JWT_SECRET=GENERATE_ON_INSTALL
ADMIN_API_TOKEN=GENERATE_ON_INSTALL
REDIS_PASSWORD=GENERATE_ON_INSTALL
KV_REST_API_TOKEN=GENERATE_ON_INSTALL
# Пустое значение: проверка через SSH. Домен включайте только для публичного HTTPS.
PUBLIC_DOMAIN=
# Необязательные ключи для ИИ и голоса.
DEEPSEEK_API_KEY=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
